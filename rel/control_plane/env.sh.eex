#!/bin/sh
set -eu

FAVN_LOG_LEVEL="${FAVN_LOG_LEVEL:-info}"
case "$FAVN_LOG_LEVEL" in
  debug|info|notice|warning|error|critical|alert|emergency) ;;
  *) echo "invalid FAVN_LOG_LEVEL" >&2; exit 1 ;;
esac

export FAVN_LOG_LEVEL
export RELEASE_TMP="${RELEASE_TMP:-/tmp/favn}"

# One-off eval commands do not communicate with a resident BEAM node. Keeping
# distribution disabled means database Jobs need no node name, cookie, or open
# Erlang distribution ports.
if [ "${RELEASE_COMMAND:-}" = "eval" ]; then
  export RELEASE_DISTRIBUTION=none
  # Mix's generated launcher always expands RELEASE_COOKIE, even when
  # distribution is disabled. This fixed non-secret value prevents a fallback
  # read of the deliberately absent releases/COOKIE file.
  export RELEASE_COOKIE=favn-eval-no-distribution
  # Boot-time progress reports are written before ReleaseCLI can route the
  # default Logger handler to stderr. Suppress them so stdout stays one JSON
  # document; the operation still emits its bounded human summary to stderr.
  export ERL_AFLAGS="${ERL_AFLAGS:-} -kernel logger_level none"
else

export ERL_AFLAGS="${ERL_AFLAGS:-} -kernel logger_level $FAVN_LOG_LEVEL"

: "${FAVN_DISTRIBUTION_COOKIE:?FAVN_DISTRIBUTION_COOKIE is required}"
: "${FAVN_BEAM_DISTRIBUTION_PORT:?FAVN_BEAM_DISTRIBUTION_PORT is required}"

validate_node_name() {
  value=$1

  case "$value" in
    *@*@*|@*|*@|*[!A-Za-z0-9_.@-]*) return 1 ;;
  esac

  local_name=${value%%@*}
  host=${value#*@}
  [ "$local_name" != "$value" ] || return 1
  [ "${#local_name}" -le 255 ] || return 1
  [ "${#host}" -le 255 ] || return 1

  normalized_host=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')

  case "$normalized_host" in
    localhost|nohost|127.*|::1|*.localhost) return 1 ;;
  esac
}

case "${RELEASE_NAME:-}" in
  favn_orchestrator)
    : "${FAVN_CONTROL_PLANE_NODE:?FAVN_CONTROL_PLANE_NODE is required}"
    local_node=$FAVN_CONTROL_PLANE_NODE
    local_node_env=FAVN_CONTROL_PLANE_NODE
    ;;
  favn_view)
    : "${FAVN_VIEW_NODE:?FAVN_VIEW_NODE is required}"
    : "${FAVN_CONTROL_PLANE_NODE:?FAVN_CONTROL_PLANE_NODE is required}"
    local_node=$FAVN_VIEW_NODE
    local_node_env=FAVN_VIEW_NODE
    if [ "$FAVN_VIEW_NODE" = "$FAVN_CONTROL_PLANE_NODE" ]; then
      echo "FAVN_VIEW_NODE must differ from FAVN_CONTROL_PLANE_NODE" >&2
      exit 1
    fi
    ;;
  *)
    echo "invalid RELEASE_NAME" >&2
    exit 1
    ;;
esac

if ! validate_node_name "$local_node"; then
  echo "invalid $local_node_env" >&2
  exit 1
fi

if [ "${RELEASE_NAME:-}" = "favn_view" ] && ! validate_node_name "$FAVN_CONTROL_PLANE_NODE"; then
  echo "invalid FAVN_CONTROL_PLANE_NODE" >&2
  exit 1
fi

case "$FAVN_DISTRIBUTION_COOKIE" in
  *[[:space:]]*) echo "invalid FAVN_DISTRIBUTION_COOKIE" >&2; exit 1 ;;
esac

cookie_length=${#FAVN_DISTRIBUTION_COOKIE}
unique_cookie_bytes=$(printf '%s' "$FAVN_DISTRIBUTION_COOKIE" | LC_ALL=C fold -w 1 | LC_ALL=C sort -u | wc -l | tr -d ' ')

if [ "$cookie_length" -lt 32 ] || [ "$cookie_length" -gt 255 ] || [ "$unique_cookie_bytes" -lt 12 ]; then
  echo "invalid FAVN_DISTRIBUTION_COOKIE" >&2
  exit 1
fi

case "$FAVN_BEAM_DISTRIBUTION_PORT" in
  ""|*[!0-9]*) echo "invalid FAVN_BEAM_DISTRIBUTION_PORT" >&2; exit 1 ;;
esac

if [ "$FAVN_BEAM_DISTRIBUTION_PORT" -lt 1 ] || [ "$FAVN_BEAM_DISTRIBUTION_PORT" -gt 65535 ]; then
  echo "invalid FAVN_BEAM_DISTRIBUTION_PORT" >&2
  exit 1
fi

ERL_EPMD_PORT="${ERL_EPMD_PORT:-4369}"
case "$ERL_EPMD_PORT" in
  ""|*[!0-9]*) echo "invalid ERL_EPMD_PORT" >&2; exit 1 ;;
esac

if [ "$ERL_EPMD_PORT" -lt 1 ] || [ "$ERL_EPMD_PORT" -gt 65535 ]; then
  echo "invalid ERL_EPMD_PORT" >&2
  exit 1
fi

export ERL_EPMD_PORT
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="$local_node"
export RELEASE_COOKIE="$FAVN_DISTRIBUTION_COOKIE"

case "${RELEASE_COMMAND:-}" in
  start|start_iex|daemon|daemon_iex)
    export ERL_AFLAGS="${ERL_AFLAGS:-} -kernel inet_dist_listen_min $FAVN_BEAM_DISTRIBUTION_PORT inet_dist_listen_max $FAVN_BEAM_DISTRIBUTION_PORT"
    ;;
esac
fi
