{
	admin off
}

(sanitized_proxy_headers) {
	header_up -Forwarded
	header_up -X-Forwarded-Host
	header_up -X-Forwarded-Port
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Proto https
}

https://favn.localhost {
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle /__proxy_header_probe {
		reverse_proxy http://proxy-header-receiver:8080 {
			import sanitized_proxy_headers
		}
	}

	reverse_proxy http://control-plane:4000 {
		import sanitized_proxy_headers

		# Bandit closes some rejected-request connections after sending the
		# response. Do not reuse a socket that may have been closed by the
		# upstream, and never mask that race by retrying mutation requests.
		transport http {
			keepalive off
		}
	}
}
