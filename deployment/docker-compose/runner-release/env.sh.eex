#!/bin/sh
set -eu

: "${FAVN_RUNNER_NODE_HOST_ALIAS:?FAVN_RUNNER_NODE_HOST_ALIAS is required}"
: "${FAVN_DISTRIBUTION_COOKIE:?FAVN_DISTRIBUTION_COOKIE is required}"

case "$FAVN_RUNNER_NODE_HOST_ALIAS" in
  *[!A-Za-z0-9_.-]*|""|localhost|nohost|127.*|::1|*.localhost)
    echo "invalid FAVN_RUNNER_NODE_HOST_ALIAS" >&2
    exit 1
    ;;
esac

export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="undefined@$FAVN_RUNNER_NODE_HOST_ALIAS"
export RELEASE_COOKIE="$FAVN_DISTRIBUTION_COOKIE"
export ERL_EPMD_PORT="${ERL_EPMD_PORT:-4369}"
